# Official WhatsApp Cloud API (Meta). Fill after you finish
# developers.facebook.com → your app → WhatsApp → API Setup.
# Never commit this file as .env.

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
WHATSAPP_API_VERSION=v21.0

# First outbound message to a new recipient must be an approved template
# (Meta test app includes hello_world). After the user replies, text is allowed for 24h.
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
